---
const icons: Record<string, string> = {
  cpu: '<rect x="4" y="4" width="16" height="16" rx="1.5"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1.5v3M15 1.5v3M9 19.5v3M15 19.5v3M1.5 9h3M1.5 15h3M19.5 9h3M19.5 15h3"/>',
  waterdrop: '<path d="M12 2.7c3.5 4 7 7.6 7 11.3a7 7 0 1 1-14 0c0-3.7 3.5-7.3 7-11.3Z"/>',
  "document-text": '<path d="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h4"/>',
  "check-circle": '<path d="m8.5 12.5 2.5 2.5 5-5.5"/><circle cx="12" cy="12" r="9.25"/>',
  "close-circle": '<path d="m9.5 9.5 5 5m0-5-5 5"/><circle cx="12" cy="12" r="9.25"/>',
  "arrow-right-up": '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  "arrow-left": '<path d="M19 12H5m6-6-6 6 6 6"/>',
};
interface Props {
  name: keyof typeof icons;
  class?: string;
  size?: string | number;
}
const { name, class: className, size = "1em" } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  set:html={icons[name]}
/>
