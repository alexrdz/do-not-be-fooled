---
import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  gap?: "none" | "3xs" | "2xs" | "xs" | "sm" | "md" | "lg" | "xl";
  justify?: "start" | "center" | "end" | "between" | "around" | "evenly";
  align?: "start" | "center" | "end" | "stretch" | "baseline";
  nowrap?: boolean;
  distributeEqually?: boolean;
  class?: string;
  [key: string]: any;
}
const { as: Tag = "div", gap, justify, align, nowrap, distributeEqually, class: className, ...attrs } = Astro.props;
const data = [gap && `gap:${gap}`, justify && `justify:${justify}`, align && `align:${align}`, nowrap && "nowrap", distributeEqually && "distribute:equally"].filter(Boolean).join(" ");
---
<Tag data-cluster={data} class={className} {...attrs}><slot /></Tag>
