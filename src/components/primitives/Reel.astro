---
interface Props {
  as?: any;
  gap?: "xs" | "sm" | "md" | "lg";
  items?: 2 | 3 | 4 | 5;
  snap?: "start" | "center" | "end";
  class?: string;
  [key: string]: any;
}
const { as: Tag = "div", gap, items, snap, class: className, ...attrs } = Astro.props;
const data = [gap && `gap:${gap}`, items && `items:${items}`, snap && `snap:${snap}`].filter(Boolean).join(" ");
---
<Tag data-reel={data} class={className} {...attrs}><slot /></Tag>
